# Copier en .env pour le développement local (jamais commité : voir .gitignore).
# En production, SCALINGO_POSTGRESQL_URL est injectée automatiquement par l'addon
# PostgreSQL : ne pas la définir ici.

# Utilisée en local / par les tests (docker-compose fournit ce service) :
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/deploiement_scalingo

# Origines autorisées par CORS, séparées par des virgules (sans espace ni slash final) :
CORS_ORIGINS=http://localhost:5173
